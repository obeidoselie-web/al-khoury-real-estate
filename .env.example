# All variables are server-only (none uses NEXT_PUBLIC_), so none reaches the browser.

# Database. Default: a local SQLite file. For Turso: libsql://<db>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:data/alkhoury.db
DATABASE_AUTH_TOKEN=

# Where uploaded listing photos are stored (local disk). Default: data/uploads
UPLOAD_DIR=

# First admin account, created by `npm run db:seed`. Leave ADMIN_PASSWORD empty to have one generated
# into data/admin-credentials.txt. Use at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Every lead is saved to the admin inbox; when set, it is also POSTed here as JSON
# (CRM, Zapier, Slack, etc.).
CONTACT_WEBHOOK_URL=

# Absolute public URL of the site, used for Open Graph/metadata links.
SITE_URL=http://localhost:3000

# Development aid: set to 1 to make the listings data layer throw, to preview the error UI.
# Ignored when NODE_ENV=production.
SIMULATE_LISTINGS_ERROR=
