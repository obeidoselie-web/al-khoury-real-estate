# Server-only. Contact-form enquiries are POSTed as JSON to this URL (CRM, Zapier, Slack, etc.).
# Leave empty in development: enquiries are accepted and logged without personal data.
CONTACT_WEBHOOK_URL=

# Absolute public URL of the site, used for Open Graph/metadata links.
SITE_URL=http://localhost:3000

# Development aid: set to 1 to make the listings data layer throw, to preview the error UI.
# Ignored when NODE_ENV=production.
SIMULATE_LISTINGS_ERROR=
